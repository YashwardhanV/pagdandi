# Caddy: automatic TLS, the static web app, and the API (which also serves map tiles).
{
	email {$ACME_EMAIL:}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), screen-wake-lock=(self)"
		-Server
	}

	@api path /v1/* /tiles/* /healthz /readyz
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/web
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://server.arcgisonline.com https://s3.amazonaws.com; connect-src 'self' https://protomaps.github.io https://s3.amazonaws.com https://server.arcgisonline.com https://demo-bucket.protomaps.com; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}
}
