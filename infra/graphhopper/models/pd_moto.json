{
  "distance_influence": 0,
  "priority": [
    { "if": "road_access == PRIVATE || road_access == NO", "multiply_by": "0" },
    { "if": "road_class == MOTORWAY", "multiply_by": "0" },
    { "if": "!car_access && road_class != TRACK", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "road_class == TRACK && (track_type == GRADE4 || track_type == GRADE5)", "limit_to": "12" },
    { "else_if": "road_class == TRACK", "limit_to": "22" },
    { "else": "", "limit_to": "car_average_speed" },
    { "if": "urban_density == CITY", "limit_to": "32" },
    { "else_if": "urban_density == RESIDENTIAL", "limit_to": "45" },
    { "if": "road_class == RESIDENTIAL || road_class == LIVING_STREET || road_class == SERVICE", "limit_to": "22" },
    { "if": "surface == DIRT || surface == GROUND || surface == SAND || surface == GRASS", "limit_to": "18" },
    { "if": "true", "limit_to": "70" }
  ]
}
