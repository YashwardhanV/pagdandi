{
  "distance_influence": 0,
  "priority": [
    { "if": "road_access == PRIVATE || road_access == NO", "multiply_by": "0" },
    { "if": "road_class == TRACK && (track_type == GRADE4 || track_type == GRADE5)", "multiply_by": "0" },
    { "if": "!car_access && road_class != TRACK", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "road_class == TRACK", "limit_to": "20" },
    { "else": "", "limit_to": "car_average_speed" },
    { "if": "urban_density == CITY", "limit_to": "35" },
    { "else_if": "urban_density == RESIDENTIAL", "limit_to": "50" },
    { "if": "road_class == RESIDENTIAL || road_class == LIVING_STREET || road_class == SERVICE", "limit_to": "25" },
    { "if": "true", "limit_to": "90" }
  ]
}
