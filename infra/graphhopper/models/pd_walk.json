{
  "distance_influence": 0,
  "priority": [
    { "if": "true", "multiply_by": "foot_priority" },
    { "if": "foot_road_access == PRIVATE || foot_road_access == NO", "multiply_by": "0" },
    { "if": "!foot_access", "multiply_by": "0" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" }
  ]
}
