{
  "distance_influence": 90,
  "priority": [
    { "if": "true", "multiply_by": "bike_priority" },
    { "if": "bike_road_access == PRIVATE || bike_road_access == NO", "multiply_by": "0" },
    { "if": "bike_road_access == DESTINATION", "multiply_by": "0.3" },
    { "if": "!bike_access && (!backward_bike_access || roundabout)", "multiply_by": "0" },
    { "else_if": "!bike_access && backward_bike_access", "multiply_by": "0.2" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0" },
    { "if": "track_type == GRADE5", "multiply_by": "0.3" },
    { "if": "road_class == TRACK || road_class == PATH", "multiply_by": "0.85" },
    { "if": "surface == DIRT || surface == GROUND || surface == SAND || surface == GRASS", "multiply_by": "0.8" }
  ],
  "speed": [
    { "if": "true", "limit_to": "bike_average_speed" },
    { "if": "!bike_access && backward_bike_access", "limit_to": "6" }
  ]
}
