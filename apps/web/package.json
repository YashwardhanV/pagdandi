    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@radix-ui/react-toggle-group": "^1.2.0",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^5.24.0",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
