{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --strictPort",
      "startServerReadyPattern": "Local",
      "url": ["http://localhost:4173/", "http://localhost:4173/explore"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 915, "deviceScaleFactor": 2.625 },
        "throttlingMethod": "simulate",
        "chromeFlags": "--headless=new --no-sandbox --use-angle=swiftshader --enable-unsafe-swiftshader",
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
