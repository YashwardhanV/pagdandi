# Pagdandi configuration (SPEC §8.4). Copy to .env (make bootstrap does this) and edit.
# .env is gitignored; never commit real secrets.

APP_ENV=dev                      # dev | prod
API_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080      # where the API is reachable (magic links point here)
WEB_BASE_URL=http://localhost:5173         # where the web app is reachable (post-login redirects)
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://pagdandi:pagdandi@localhost:5432/pagdandi?sslmode=disable
TEST_DATABASE_URL=postgres://pagdandi:pagdandi@localhost:5432/pagdandi_test?sslmode=disable
POSTGRES_PASSWORD=pagdandi
REDIS_URL=redis://localhost:6379/0

# GraphHopper instances. A comma-separated list enables blue/green failover.
GH_IN_URL=http://localhost:8989
GH_SE_URL=http://localhost:8990
GH_JAVA_XMX=3g                   # heap for imports (REGION=all needs ~12g, SPEC §5)
GH_SERVE_XMX=2g                  # heap for serving

# Geocoding: self-hosted Photon in prod; the public instance (≤1 req/s, cached) in dev.
PHOTON_URL=https://photon.komoot.io
GEOCODER_CONTACT_EMAIL=          # sent in the User-Agent to public geocoders; set your own contact

# Sessions: 32+ random characters. `make bootstrap` generates one into .env.
SESSION_SECRET=

# Email magic links. Leave SMTP_HOST empty in dev: links are printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pagdandi <no-reply@example.com>

# Google sign-in is enabled when both are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

REGIONS_FILE=../../data/regions.yaml

# Web app (Vite) settings.
VITE_API_BASE=                   # empty = same origin (/v1 is proxied in dev, reverse-proxied by Caddy in prod)
VITE_TILES_MODE=local            # local = self-hosted PMTiles, remote = OpenFreeMap hosted tiles (dev fallback)

# Production deploy (SPEC §16); `make deploy` skips when these are missing.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_DOMAIN=
BACKUP_S3_URL=
