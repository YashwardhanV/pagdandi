# Pagdandi configuration. Copy to .env (make bootstrap does this) and edit.
# There are no secrets in v2: no accounts, no database.

APP_ENV=dev                      # dev | prod
API_ADDR=:8080
GH_URL=http://localhost:8989     # GraphHopper
CORS_ORIGINS=http://localhost:5173

# Data build
GH_JAVA_XMX=3g                   # heap for the graph import (Indore needs ~2-3 GB)
GH_SERVE_XMX=2g                  # heap for serving
GH_ELEVATION=true                # false skips elevation (no hills/climb stats)

# Search: the public Photon instance is rate-limited to 1 req/s; self-host for production.
PHOTON_URL=https://photon.komoot.io
GEOCODER_CONTACT_EMAIL=          # sent in the User-Agent to the public geocoder

# Production (make deploy skips when these are missing)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_DOMAIN=
