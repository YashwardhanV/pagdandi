<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic town for deterministic routing-profile tests (SPEC §14).
  All routes go from A (node 1, SW) to C (node 3, NE), about 0.9 km apart.

  * Ring Road (unclassified, asphalt): the long paved way round, about 7.2 km.
  * Kaccha track (highway=track, grade2, dirt): the diagonal A-M-C; a gate (barrier=gate,
    no access tags) sits on M. Standard must avoid it; shortcut must take it and warn about the gate.
  * Three tempting direct paved connectors that EVERY profile must refuse:
      - Private Lane (access=private) via Q
      - Expressway (highway=motorway) via R
      - Cantonment Road via T, inside a landuse=military polygon
  * A small grid of residential streets hangs off the ring so the network is not trivial.
-->
<osm version="0.6" generator="pagdandi-fixture">
  <!-- core junctions -->
  <node id="1" version="1" lat="23.0000000" lon="77.0000000"/>
  <node id="3" version="1" lat="23.0060000" lon="77.0060000"/>
  <!-- ring road corners -->
  <node id="11" version="1" lat="23.0000000" lon="77.0200000"/>
  <node id="12" version="1" lat="23.0200000" lon="77.0200000"/>
  <node id="13" version="1" lat="23.0200000" lon="77.0060000"/>
  <node id="14" version="1" lat="23.0100000" lon="77.0060000"/>
  <!-- track midpoint with a gate -->
  <node id="2" version="1" lat="23.0030000" lon="77.0030000">
    <tag k="barrier" v="gate"/>
  </node>
  <!-- private lane -->
  <node id="21" version="1" lat="23.0035000" lon="77.0022000"/>
  <!-- expressway -->
  <node id="31" version="1" lat="23.0022000" lon="77.0038000"/>
  <!-- cantonment road and military polygon -->
  <node id="41" version="1" lat="23.0048000" lon="77.0012000"/>
  <node id="51" version="1" lat="23.0040000" lon="77.0002000"/>
  <node id="52" version="1" lat="23.0040000" lon="77.0024000"/>
  <node id="53" version="1" lat="23.0056000" lon="77.0024000"/>
  <node id="54" version="1" lat="23.0056000" lon="77.0002000"/>
  <!-- residential grid east of the ring -->
  <node id="61" version="1" lat="23.0050000" lon="77.0200000"/>
  <node id="62" version="1" lat="23.0050000" lon="77.0260000"/>
  <node id="63" version="1" lat="23.0100000" lon="77.0260000"/>
  <node id="64" version="1" lat="23.0100000" lon="77.0200000"/>
  <node id="65" version="1" lat="23.0150000" lon="77.0200000"/>
  <node id="66" version="1" lat="23.0150000" lon="77.0260000"/>

  <way id="101" version="1">
    <nd ref="1"/><nd ref="11"/><nd ref="61"/><nd ref="64"/><nd ref="65"/><nd ref="12"/><nd ref="13"/><nd ref="14"/><nd ref="3"/>
    <tag k="highway" v="unclassified"/>
    <tag k="surface" v="asphalt"/>
    <tag k="name" v="Ring Road"/>
  </way>
  <way id="102" version="1">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/>
    <tag k="highway" v="track"/>
    <tag k="tracktype" v="grade2"/>
    <tag k="surface" v="dirt"/>
    <tag k="name" v="Kaccha track"/>
  </way>
  <way id="103" version="1">
    <nd ref="1"/><nd ref="21"/><nd ref="3"/>
    <tag k="highway" v="residential"/>
    <tag k="surface" v="asphalt"/>
    <tag k="access" v="private"/>
    <tag k="name" v="Private Lane"/>
  </way>
  <way id="104" version="1">
    <nd ref="1"/><nd ref="31"/><nd ref="3"/>
    <tag k="highway" v="motorway"/>
    <tag k="surface" v="asphalt"/>
    <tag k="oneway" v="yes"/>
    <tag k="name" v="Expressway"/>
  </way>
  <way id="105" version="1">
    <nd ref="1"/><nd ref="41"/><nd ref="3"/>
    <tag k="highway" v="residential"/>
    <tag k="surface" v="asphalt"/>
    <tag k="name" v="Cantonment Road"/>
  </way>
  <way id="106" version="1">
    <nd ref="51"/><nd ref="52"/><nd ref="53"/><nd ref="54"/><nd ref="51"/>
    <tag k="landuse" v="military"/>
    <tag k="name" v="Cantonment"/>
  </way>
  <way id="107" version="1">
    <nd ref="61"/><nd ref="62"/><nd ref="63"/><nd ref="64"/>
    <tag k="highway" v="residential"/>
    <tag k="surface" v="asphalt"/>
  </way>
  <way id="108" version="1">
    <nd ref="63"/><nd ref="66"/><nd ref="65"/>
    <tag k="highway" v="residential"/>
    <tag k="surface" v="asphalt"/>
  </way>
</osm>
