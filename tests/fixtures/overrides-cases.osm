<?xml version="1.0" encoding="UTF-8"?>
<!-- Cases for infra/tools/osm_overrides.py (SPEC §4.3). Coordinates sit inside the
     Mumbai–Pune Expressway bbox of data/overrides/in_2w_restrictions.yaml. -->
<osm version="0.6" generator="pagdandi-fixture">
  <node id="1" version="1" lat="18.7000000" lon="73.3000000"/>
  <node id="2" version="1" lat="18.7010000" lon="73.3010000"/>
  <node id="3" version="1" lat="18.7020000" lon="73.3020000"/>
  <node id="4" version="1" lat="10.0000000" lon="10.0000000"/>
  <node id="5" version="1" lat="10.0010000" lon="10.0010000"/>
  <!-- India: named expressway inside its bbox → banned -->
  <way id="10" version="1"><nd ref="1"/><nd ref="2"/>
    <tag k="highway" v="motorway"/><tag k="name" v="Mumbai Pune Expressway"/><tag k="motorcar" v="yes"/></way>
  <!-- India: same name, wrong highway class (service road) → untouched -->
  <way id="11" version="1"><nd ref="2"/><nd ref="3"/>
    <tag k="highway" v="service"/><tag k="name" v="Mumbai Pune Expressway service road"/></way>
  <!-- India: same name far outside the bbox → untouched -->
  <way id="12" version="1"><nd ref="4"/><nd ref="5"/>
    <tag k="highway" v="motorway"/><tag k="name" v="Mumbai Pune Expressway"/></way>
  <!-- India: motorcycle=no → motor_vehicle=no -->
  <way id="13" version="1"><nd ref="1"/><nd ref="3"/>
    <tag k="highway" v="residential"/><tag k="motorcycle" v="no"/></way>
  <!-- Sweden: track without motor access → closed to mopeds -->
  <way id="20" version="1"><nd ref="4"/><nd ref="5"/>
    <tag k="highway" v="track"/></way>
  <!-- Sweden: track with explicit motor access → open -->
  <way id="21" version="1"><nd ref="4"/><nd ref="5"/>
    <tag k="highway" v="track"/><tag k="motor_vehicle" v="destination"/></way>
</osm>
